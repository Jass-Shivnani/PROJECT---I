# Dione AI - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# LLM Configuration
# ============================================
DIONE_LLM_BACKEND=gemini
DIONE_LLM_MODEL=gemini-3.5-flash-lite
DIONE_LLM_API_KEY=
DIONE_LLM_API_BASE_URL=
DIONE_LLM_OLLAMA_HOST=http://127.0.0.1:11434
DIONE_LLM_LLAMACPP_PATH=

# ============================================
# Server Configuration
# ============================================
DIONE_HOST=0.0.0.0
DIONE_PORT=8900
DIONE_DEBUG=true
DIONE_SECRET_KEY=change-this-to-a-random-secret-key

# ============================================
# Knowledge Graph
# ============================================
DIONE_KNOWLEDGE_DB_PATH=./data/knowledge/dione.db
DIONE_KNOWLEDGE_GRAPH_PATH=./data/knowledge/graph.json

# ============================================
# Vector Store (ChromaDB)
# ============================================
DIONE_CHROMA_PATH=./data/vectors
DIONE_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ============================================
# Memory
# ============================================
DIONE_MEMORY_PATH=./data/memory
DIONE_MAX_CONTEXT_TOKENS=4096

# ============================================
# Sentiment Engine
# ============================================
DIONE_SENTIMENT_ENABLED=true
DIONE_SENTIMENT_MODEL=local

# ============================================
# Plugin Credentials (fill as needed)
# ============================================
# Gmail
DIONE_GMAIL_CREDENTIALS_PATH=
DIONE_GMAIL_TOKEN_PATH=

# WhatsApp (via Twilio or local bridge)
DIONE_WHATSAPP_BRIDGE=local
DIONE_TWILIO_SID=
DIONE_TWILIO_AUTH_TOKEN=
DIONE_TWILIO_WHATSAPP_NUMBER=

# Calendar
DIONE_CALENDAR_PROVIDER=google
DIONE_GOOGLE_CALENDAR_CREDENTIALS=

# ============================================
# Security
# ============================================
DIONE_SANDBOX_ENABLED=true
DIONE_REQUIRE_CONFIRMATION_FOR=delete,send,execute
DIONE_MAX_RETRIES=3
