# Dione - Git Ignore Rules

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
env/

# Environment
.env
.env.local
.env.*.local

# Data (local storage - never commit)
data/
*.db
*.sqlite3

# Dependencies
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
.pnp

# Backup & Lock files
*.lock
*_backup*
requirements_backup.txt
backup_pre_upgrade/
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Flutter
mobile/dione_app/build/
mobile/dione_app/.dart_tool/
mobile/dione_app/.packages
mobile/dione_app/.flutter-plugins
mobile/dione_app/.flutter-plugins-dependencies
mobile/dione_app/android/.gradle/
mobile/dione_app/ios/Pods/
mobile/dione_app/ios/.symlinks/

# Logs & temp
*.log
logs/
scratch/
*.tmp
*.node
*.dll
*.exe
*.msi
*.zip
*.tar.gz

# Model files (too large)
*.gguf
*.bin
models/

# Build outputs
installer_output/

# External reference repos & temporary analysis
references/
archive/
codex/
codex-main/
hermes-agent-main/
openclaw_repo/
docs/openclaw-main/
docs/extracted_report_v2/
docs/docx_actual_images/

# Temporary test captures and text dumps
test*.png
real_screen_captured.png
junction_check*.png
*.txt
*.jsonl
all_highlighted_blocks.json
new_turnitin_highlights_*.json
received_*.json

# Secrets
credentials/
tokens/
*.pem
*.key

# Office locks
~$*
docs/~$*
